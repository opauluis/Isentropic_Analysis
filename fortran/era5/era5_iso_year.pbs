#!/bin/bash
# One year of the ERA5 isentropic analysis on NCAR Casper, one day per array subjob
#
# Submit from fortran/era5 (after make FC=ifx):
#   qsub -v YEAR=2020 era5_iso_year.pbs
#   qsub -v YEAR=2020,OUT_DIR=/glade/derecho/scratch/$USER/ERA5/ISO/THETAE era5_iso_year.pbs
#
# Days whose output file already exists and is readable are skipped, so the same command
# resubmits only the failed days (FORCE=1 reruns everything). Index 366 does nothing in a
# non-leap year. Subjob logs are era5_iso.o<jobid>.<index> in the submission directory.
# Each day needs ~6 GB and ~2 min.

#PBS -N era5_iso
#PBS -A UNYU0015
#PBS -q casper
#PBS -J 1-366
#PBS -l select=1:ncpus=1:mem=8GB
#PBS -l walltime=00:15:00
#PBS -j oe

module load intel netcdf
set -eu

: "${YEAR:?submit with qsub -v YEAR=yyyy}"
OUT_DIR=${OUT_DIR:-/glade/derecho/scratch/$USER/ERA5/ISO/THETAE}
FORCE=${FORCE:-0}

day_of_year=$PBS_ARRAY_INDEX
date=$(date -u -d "$YEAR-01-01 + $((day_of_year - 1)) days" +%Y%m%d)
if [ "${date:0:4}" != "$YEAR" ]; then
  echo "$YEAR has no day $day_of_year"
  exit 0
fi
month=${date:4:2}
day=${date:6:2}

out_file=$OUT_DIR/$YEAR/ERA5_STR_THE.${YEAR}_${month}_${day}.nc
if [ "$FORCE" != 1 ] && ncdump -h "$out_file" > /dev/null 2>&1; then
  echo "$out_file exists, skipping"
  exit 0
fi

mkdir -p "$OUT_DIR/$YEAR"
cd "$PBS_O_WORKDIR"
./era5_iso.exe "$YEAR" "$month" "$day" "$OUT_DIR"
